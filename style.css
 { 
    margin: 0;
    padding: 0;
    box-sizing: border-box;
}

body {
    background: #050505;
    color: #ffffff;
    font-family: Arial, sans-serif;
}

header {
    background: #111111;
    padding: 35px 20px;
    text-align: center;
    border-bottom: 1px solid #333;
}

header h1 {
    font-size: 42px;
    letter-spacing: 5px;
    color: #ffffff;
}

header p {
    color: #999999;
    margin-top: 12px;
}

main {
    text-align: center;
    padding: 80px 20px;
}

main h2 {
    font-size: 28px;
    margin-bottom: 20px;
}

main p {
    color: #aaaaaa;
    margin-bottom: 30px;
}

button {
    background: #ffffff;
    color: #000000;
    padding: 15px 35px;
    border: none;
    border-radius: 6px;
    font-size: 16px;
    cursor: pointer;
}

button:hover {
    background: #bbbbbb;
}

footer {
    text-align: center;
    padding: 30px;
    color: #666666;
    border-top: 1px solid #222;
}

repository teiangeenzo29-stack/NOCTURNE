
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #050505;
    color: #ffffff;
    font-family: Arial, sans-serif;
}

header {
    background: #111111;
    padding: 35px 20px;
    text-align: center;
    border-bottom: 1px solid #333;
}

header h1 {
    font-size: 42px;
    letter-spacing: 5px;
    color: #ffffff;
}

header p {
    color: #999999;
    margin-top: 12px;
}

main {
    text-align: center;
    padding: 80px 20px;
}

main h2 {
    font-size: 28px;
    margin-bottom: 20px;
}

main p {
    color: #aaaaaa;
    margin-bottom: 30px;
}

button {
    background: #ffffff;
    color: #000000;
    padding: 15px 35px;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background: #bbbbbb;
}

footer {
    text-align: center;
    padding: 30px;
    color: #666666;
    border-top: 1px solid #222;
}
